operations -> movements [color="#7890a5", style="solid", tooltip="operation_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
products -> movements [color="#7890a5", style="solid", tooltip="product_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
branches -> movements [color="#b48955", style="dashed", tooltip="branch_id", taillabel="0..1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
transfers -> movements [color="#b48955", style="dashed", tooltip="transfer_id", taillabel="0..1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
branches -> alerts [color="#7890a5", style="solid", tooltip="branch_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
products -> alerts [color="#7890a5", style="solid", tooltip="product_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
profiles -> audit_events [color="#b48955", style="dashed", tooltip="actor_profile_id", taillabel="0..1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
branches -> physical_counts [color="#7890a5", style="solid", tooltip="branch_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
products -> physical_counts [color="#7890a5", style="solid", tooltip="product_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
