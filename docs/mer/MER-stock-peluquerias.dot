branches -> inventory [color="#7890a5", style="solid", tooltip="branch_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
products -> inventory [color="#7890a5", style="solid", tooltip="product_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
profiles -> operations [color="#7890a5", style="solid", tooltip="actor_profile_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
products -> transfers [color="#7890a5", style="solid", tooltip="product_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
branches -> transfers [color="#7890a5", style="solid", tooltip="from_branch_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
branches -> transfers [color="#7890a5", style="solid", tooltip="to_branch_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
