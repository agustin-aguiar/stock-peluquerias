operations -> physical_counts [color="#b48955", style="dashed", tooltip="operation_id", taillabel="0..1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
profiles -> import_batches [color="#7890a5", style="solid", tooltip="actor_profile_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
}