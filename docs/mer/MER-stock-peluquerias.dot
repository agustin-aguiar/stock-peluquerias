digraph MER {
 graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.65", ranksep="1.0", splines=true, outputorder=edgesfirst];
 node [shape=plain, fontname="Arial"];
 edge [color="#7890a5", penwidth=1.25, arrowsize=.58, fontname="Arial", fontsize=9, fontcolor="#364d63"];
 auth_users [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#edf0ff", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="auth.users\l────────────\lid  [PK]\lemail\l"];
chains [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e3f3ed", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="chains\l────────────\lid  [PK]\lname\ltimezone\l"];
branches [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e3f3ed", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="branches\l────────────\lid  [PK]\lchain_id  [FK]\lcode  [UQ*]\lname\lis_active\l"];
profiles [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e3f3ed", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="profiles\l────────────\lid  [PK]\lchain_id  [FK]\lauth_user_id  [FK · UQ · opc.]\lbranch_id  [FK · opc.]\lemail\lrole\lis_active\l"];
products [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e3f3ed", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="products\l────────────\lid  [PK]\lchain_id  [FK]\lsku  [UQ*]\lname\lunit\lpresentation_qty\l"];
inventory [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e8f0fc", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="inventory\l────────────\lid  [PK]\lchain_id  [FK]\lbranch_id  [FK · UQ*]\lproduct_id  [FK · UQ*]\lbalance\lmin_qty\lversion\l"];
operations [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e8f0fc", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="operations\l────────────\lid  [PK]\lchain_id  [FK]\lactor_profile_id  [FK]\ltype\lidempotency_key  [UQ*]\lcreated_at\l"];
transfers [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e8f0fc", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="transfers\l────────────\lid  [PK]\lchain_id  [FK]\lproduct_id  [FK]\lfrom_branch_id  [FK]\lto_branch_id  [FK]\lcreated_by  [FK]\ldispatched_by  [FK · opc.]\l…\l"];
movements [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e8f0fc", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="movements\l────────────\lid  [PK]\lchain_id  [FK]\loperation_id  [FK]\lproduct_id  [FK]\lbranch_id  [FK · opc.]\ltransfer_id  [FK · opc.]\lreverses_movement_id  [FK · UQ · opc.]\l…\l"];
alerts [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e8f0fc", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="alerts\l────────────\lid  [PK]\lchain_id  [FK]\lbranch_id  [FK]\lproduct_id  [FK]\lstatus\lopened_at\l"];
physical_counts [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#e8f0fc", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="physical_counts\l────────────\lid  [PK]\lchain_id  [FK]\lbranch_id  [FK]\lproduct_id  [FK]\lsubmitted_by  [FK]\lreviewed_by  [FK · opc.]\loperation_id  [FK · opc.]\l…\l"];
import_batches [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#fff1df", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="import_batches\l────────────\lid  [PK]\lchain_id  [FK · UQ*]\lactor_profile_id  [FK]\lkind  [UQ*]\lcontent_hash  [UQ*]\lrows\l"];
audit_events [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#fff1df", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="audit_events\l────────────\lid  [PK]\lchain_id  [FK]\lactor_profile_id  [FK · opc.]\laction\lentity_type\lentity_id\lold_values\l…\l"];
daily_low_stock_emails [shape=box, style="rounded,filled", color="#9eafbf", fillcolor="#fff1df", fontname="Arial", fontsize=11, penwidth=1.2, margin="0.15,0.12", label="daily_low_stock_emails\l────────────\lid  [PK]\lchain_id  [FK · UQ*]\llocal_date  [UQ*]\lrecipient_email  [UQ*]\lsent_at\llast_error\l"];
 chains -> branches [color="#7890a5", style="solid", tooltip="chain_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
chains -> profiles [color="#7890a5", style="solid", tooltip="chain_id", taillabel="1", headlabel="0..N", labeldistance=1.6, labelangle=24, constraint=true];
auth_users -> profiles [color="#b48955", style="dashed", tooltip="auth_user_id", taillabel="0..1", headlabel="0..1", labeldistance=1.6, labelangle=24, constraint=true];
